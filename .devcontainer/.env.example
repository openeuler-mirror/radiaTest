# radiaTest devcontainer 环境变量
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：项目 server.ini 由 configparser 解析，中间件/数据库密码中不要出现 # % 等字符

# ---- 中间件（默认值与 docker-compose.yml 保持一致；如修改请两边同步）----
RADIATEST_DB_PASSWORD=1234
RADIATEST_REDIS_PASSWORD=radiaTest1234 # gitleaks:allow dev-only 默认值
RADIATEST_RABBITMQ_USER=radiaTest
RADIATEST_RABBITMQ_PASSWORD=1234

# ---- 后端签名/加密密钥（dev 默认值，生产环境必须更换）----
RADIATEST_TOKEN_SECRET_KEY=dev-only-token-secret-change-me
# AES_KEY 需要 16/24/32 位十六进制字符串
RADIATEST_AES_KEY=0123456789abcdef0123456789abcdef # gitleaks:allow dev-only 默认值

# ---- 管理员（配置后执行 flask init_asr 初始化管理员/角色/权限）----
RADIATEST_ADMIN_USERNAME=
RADIATEST_ADMIN_PASSWORD=

# ---- 外部平台（可留空；也可通过宿主环境变量注入，见 devcontainer.json remoteEnv）----
OPENQA_URL=
GITEE_TOKEN=
MAJUN_ACCESS_TOKEN=
V5_ACCESS_TOKEN=

# ---- gitee OAuth 登录（可选，配置后登录流程才可用）----
RADIATEST_OAUTH_REDIRECT_URI=
RADIATEST_OAUTH_HOME_URL=
RADIATEST_OAUTH_GET_TOKEN_URL=
RADIATEST_OAUTH_CLIENT_ID=
RADIATEST_OAUTH_CLIENT_SECRET=
RADIATEST_OAUTH_GET_USER_INFO_URL=

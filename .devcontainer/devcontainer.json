{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "radiaTest",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    8080,
    21500,
    13306,
    16379,
    15673
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Vue.volar"
      ],
      "settings": {
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[vue]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "remoteEnv": {
    "GITEE_TOKEN": "${localEnv:GITEE_TOKEN:}",
    "MAJUN_ACCESS_TOKEN": "${localEnv:MAJUN_ACCESS_TOKEN:}",
    "OPENQA_URL": "${localEnv:OPENQA_URL:}",
    "V5_ACCESS_TOKEN": "${localEnv:V5_ACCESS_TOKEN:}"
  },
  "postCreateCommand": "bash /workspace/.devcontainer/post_install.sh"
}

# 应用(Application)
APP_ENV=development
APP_NAME=kronos
API_V1_PREFIX=/api/v1

# 数据库(Database)。服务器 dev/prod 环境使用 deploy/server.env.example。
DATABASE_URL=postgresql+psycopg://kronos:change-me@localhost:5432/kronos_dev
TEST_DATABASE_URL=postgresql+psycopg://kronos:change-me@localhost:5432/kronos_test

# 安全(Security)。自行生成真实值，且不要提交。
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESOURCE_SECRET_KEY=change-me-fernet-key

# CORS。服务器通过 nginx 同源代理时保持为空。
CORS_ORIGINS=

# 异步任务(Async Task)。服务器 Compose 默认使用 redis://redis:6379/0。
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# VM 申请释放(VM Request/Release)
VM_IMAGE_REPO_ROOT=http://172.168.131.94:9400/repo_list/mugen.mirror/iteration
VM_OPENEULER_UPDATE_REPO_ROOT=http://121.36.84.172/repo.openeuler.org
VM_DAILYBUILD_REPO_ROOT=http://172.168.131.94:9400/repo_list/dailybuild.repo
VM_DHCP_LEASES_URL=http://172.168.131.94:9400/dhcpd.leases
VM_NETWORK_BRIDGE=br0
VM_MAX_CONCURRENT_PER_HOST=4
DISPLAY_TIMEZONE=Asia/Shanghai

# LLM 智能助手。BASE_URL 填 API 版本根路径，客户端会追加 /chat/completions。
LLM_ASSISTANT_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=6
# 环境标识：development 或 production
APP_ENV=production
APP_NAME=kronos
API_V1_PREFIX=/api/v1
WEB_PORT=80

# PostgreSQL
POSTGRES_DB=kronos_prod
POSTGRES_USER=kronos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://kronos:change-me@postgres:5432/kronos_prod

# 安全配置：每套环境必须使用不同的随机值
JWT_SECRET_KEY=change-me-change-me-change-me-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESOURCE_SECRET_KEY=change-me-fernet-key

# nginx 同源代理时保持为空
CORS_ORIGINS=

# Celery/Redis。Compose 内默认使用 redis://redis:6379/0。
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=100

# VM 申请释放
VM_IMAGE_REPO_ROOT=http://172.168.131.94:9400/repo_list/mugen.mirror
VM_OPENEULER_UPDATE_REPO_ROOT=http://121.36.84.172/repo.openeuler.org
VM_DAILYBUILD_REPO_ROOT=http://172.168.131.94:9400/repo_list/dailybuild.repo
VM_DHCP_LEASES_URL=http://172.168.131.94:9400/dhcpd.leases

# RC 版本软件包比对
RC_DAILYBUILD_BASE_URL=http://121.36.84.172/dailybuild
RC_PKGLIST_CACHE_DIR=/data/rc-pkglist-cache
RC_EXPORT_DIR=/data/rc-exports
VM_NETWORK_BRIDGE=br0
VM_MAX_CONCURRENT_PER_HOST=4
DISPLAY_TIMEZONE=Asia/Shanghai
VM_HOST_SSH_KEY_PATH=/etc/kronos/ssh/id_rsa
VM_HOST_SCRIPT_TIMEOUT_SECONDS=4200

# 飞书 LLM 智能助手（首版只读）
LLM_ASSISTANT_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=6

# Mugen 用例同步
MUGEN_REPO_URL=https://atomgit.com/openeuler/mugen.git
MUGEN_REPO_BRANCH=master

# 初始 admin（默认 openEuler12#$；deploy 的 seed-admin 幂等创建，已存在则跳过。prod 建议改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=openEuler12#$
